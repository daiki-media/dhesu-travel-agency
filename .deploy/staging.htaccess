
# =============================================================================
# STAGING-ONLY BLOCK
# Appended to out/.htaccess by .github/workflows/deploy.yml when the target is
# staging. It is never appended for production, so dhesu.com cannot inherit a
# noindex header or a password prompt by accident.
# =============================================================================

# Belt and braces against indexing. The canonical tags already point at
# dhesu.com (see src/data/site.ts), but a canonical is a hint — this is a
# directive, and the password wall below means crawlers never get this far.
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow, noarchive"
</IfModule>

# Password wall.
#
# SETUP (once): cPanel > Directory Privacy > staging.dhesu.com > tick "Password
# protect this directory", then add a user. cPanel writes the password file and
# shows you its path. Put that exact path in AuthUserFile below, then delete the
# .htaccess cPanel generated in the docroot — this file replaces it, because CI
# overwrites .htaccess on every deploy and would otherwise wipe cPanel's copy.
AuthType Basic
AuthName "Dhesu staging"
AuthUserFile "/home/dhesuhol/.htpasswds/staging.dhesu.com/passwd"
Require valid-user
